{
  "manifest_version": 3,
  "name": "AskDocs",
  "version": "0.1.0",
  "description": "Chat with public and private docs through a local AskDocs backend.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "tabs", "scripting"],
  "icons": {
    "16": "icons/askdocs-16.png",
    "24": "icons/askdocs-24.png",
    "32": "icons/askdocs-32.png",
    "48": "icons/askdocs-48.png",
    "128": "icons/askdocs-128.png"
  },
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://host.docker.internal/*",
    "https://readthedocs.io/*",
    "https://*.readthedocs.io/*",
    "https://*.readthedocs-hosted.com/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/askdocs-16.png",
      "24": "icons/askdocs-24.png",
      "32": "icons/askdocs-32.png"
    },
    "default_title": "Open AskDocs"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
